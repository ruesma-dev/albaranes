# --- monorepo albaranes ---
.idea/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
coverage.json
.coverage
services/*/coverage.json
infra/*.local.ps1
.arnes_cache/

# >>> ARNES-BASE: reglas anadidas por el instalador del arnes. >>>
*.pdf
*.docx
*.xlsx
*.pptx
*.doc
*.xls
*.ppt
# <<< ARNES-BASE: fin del bloque. <<<

# Datos de runtime del emulador Azurite (si se arranca sin --location)
__azurite_db_*
AzuriteConfig
__blobstorage__/
__queuestorage__/

# Originales de albaran para el banco de evals: PDF, PNG, JPG o lo que venga.
# Son documentos de proveedor CON PRECIOS y no entran en git en ningun
# formato. Hasta el 15-sep-2026 solo los tapaba la regla '*.pdf' de arriba,
# asi que un original en PNG habria entrado sin que nadie lo notara.
# Al repositorio entran unicamente los fixtures JSON ya barridos.
evals/inputs/
# Incluye evals/inputs/fuente/, donde se deja una copia del Excel de trabajo
# del humano (evals_summary.xlsx). El original vive en OneDrive; aqui solo
# entra una copia para que el conversor lea un fichero estable y no
# bloqueado. Lleva precios de proveedor: no se versiona.

# Informes de evals: imprimen 'esperado X, obtenido Y' campo a campo, asi que
# arrastran PRECIOS E IMPORTES de albaranes de proveedor. Se regeneran cuando
# hacen falta (python -m evals.runner) y no entran en git. Retirados del
# seguimiento el 18-sep-2026; lo ya commiteado sigue en el historial.
progress/evals_*.md
progress/historico/evals_*.md
progress/impl_F-043_evals_*.md
