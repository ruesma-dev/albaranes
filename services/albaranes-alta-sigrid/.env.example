# ============================================================
# Servicio 9 - albaranes-alta-sigrid (F-053). SIN VALORES: cada
# entorno pone los suyos. Los secretos (SIGRID_API_FUNCTION_KEY,
# PG_PASSWORD, GRAPH_KEY) nunca se escriben en el repositorio.
# ============================================================

# --- Llaves del alta (design §7 de F-053) ---
# Vacía = feature apagada (sv9 confirma los mensajes sin hacer nada).
ALTA_SIGRID_DESDE_UTC=
# Solo el literal true activa el modo real. En local NO se pone nunca.
ALTA_SIGRID_COMMIT=
# F-110: solo el literal true manda el precio bruto y el dto de las líneas con
# descuento. Mismo valor que en sv4. Apagada por defecto; la enciende el humano.
ALTA_SIGRID_ENVIAR_DTO=
# Minutos de espera antes de retomar un alta en_curso/incierto (defecto 15).
ALTA_SIGRID_ESPERA_INCIERTO_MIN=
# Tolerancia en euros por línea al comparar la previa (defecto 0.05).
ALTA_SIGRID_TOLERANCIA_EUR=
# CSV de códigos de aviso que mandan a revisar (defecto producto_sin_historico).
ALTA_SIGRID_AVISOS_BLOQUEANTES=
# Login de Sigrid (dbo.usu) de RESPALDO: va en el alta y el adjunto cuando quien
# aprobó no casa con un login (F-053 v8, R47). Vacío = esas altas, a error.
ALTA_SIGRID_USUARIO_RESPALDO=
# F-069: Lista de excepciones (JSON) Login -> {"usu"?, "empide"?}, para quien
# no casa por su correo. Vacía es lo normal: el usu sale del login del correo y
# el empide del empleado de Sigrid con ese correo (dbo.emp.traele). Solo Logins
# e ide: nunca correos completos, nombres ni DNI. Mal escrita, sv9 no arranca.
ALTA_SIGRID_EQUIVALENCIAS_USUARIO=
# JSON familia -> producto genérico, con clave "*". Mismo valor que en sv4.
ALTA_SIGRID_PRODUCTO_POR_DEFECTO=

# --- sigrid-api ---
SIGRID_API_BASE_URL=
SIGRID_API_FUNCTION_KEY=
SIGRID_API_DATABASE=
SIGRID_API_TIMEOUT_S=

# --- PostgreSQL ---
PG_HOST=
PG_PORT=
PG_DB=
PG_USER=
PG_PASSWORD=

# --- Graph / SharePoint (PDF del albarán) ---
GRAPH_KEY=
SHAREPOINT_MODE=
SHAREPOINT_FOLDER_URL=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_DRIVE_NAME=
SHAREPOINT_DRIVE_ID=
GRAPH_TIMEOUT_S=

# --- Colas (una de las dos) ---
COLAS_CONNECTION_STRING=
COLAS_ACCOUNT_URL=

# --- Log ---
LOG_LEVEL=
LOG_DIR=
