# ============================================================
# Servicio 3 - albaranes-persistence
# ============================================================

GRAPH_KEY={"tenant_id":"xx","client_id":"x","client_secret":"x"}
SHAREPOINT_FOLDER_URL=
SHAREPOINT_FOLDER_ROOT=albaranes
SHAREPOINT_LINK_TYPE=view
SHAREPOINT_LINK_SCOPE=organization
SHAREPOINT_CREATE_LINK=true
SHAREPOINT_DRIVE_ID=xx

# opcional, solo informativo
SHAREPOINT_DRIVE_NAME=Documentos

PG_HOST=localhost
PG_PORT=5432
PG_DB=albaranes
PG_USER=postgres
PG_PASSWORD=admin

PG_ADMIN_DB=postgres
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=admin

API_HOST=127.0.0.1
API_PORT=8001
HTTP_TIMEOUT_S=60
LOG_LEVEL=INFO
LOG_DIR=logs
SERVICE_VERSION=1.0.0

SIGRID_API_BASE_URL=https://func-sigridapi-dev-huyke.azurewebsites.net
SIGRID_API_FUNCTION_KEY=xx
SIGRID_API_DATABASE=ruesma
SIGRID_API_TIMEOUT_S=30
OBRA_ENRICHMENT_ENABLED=true

# --- Redes deterministas de identificacion (F-002) ---
# A false, el comportamiento es exactamente el previo a la feature.
# Obra que no existe en Sigrid -> el merge se queda SIN obra y a revision.
RED_OBRA_ENABLED=true
# CIF que no existe en el maestro prv -> revision; se aplica el candidato
# claro de la obra (F-062, abajo) o, si no lo hay, se propone.
RED_PROVEEDOR_CIF_ENABLED=true
# (F-062) Candidato claro con contrato en la obra: CIF valido y nombre con
# score >= SCORE_MIN; varios -> gana el CIF mas cercano al leido si saca
# MARGEN_DISTANCIA al siguiente. Se aplica en el merge ANTES de buscar
# contratos y va a revision. A false: solo se propone (D3 de F-002).
RED_PROVEEDOR_CORRECCION_ENABLED=true
RED_PROVEEDOR_CORRECCION_SCORE_MIN=1.0
RED_PROVEEDOR_CORRECCION_MARGEN_DISTANCIA=2
# Fecha del albaran alejada de la recepcion del correo -> revision.
FECHA_GUARD_ENABLED=true
FECHA_GUARD_MAX_DIAS=365

VALUATION_API_BASE_URL=http://127.0.0.1:8003
# debdido al orquestador se pone false
VALUATION_TRIGGER_ENABLED=false
VALUATION_TRIGGER_TIMEOUT_S=3.0
VALUATION_TRIGGER_SYNC_TIMEOUT_S=300.0

